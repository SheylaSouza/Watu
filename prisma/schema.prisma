// The models below this configuration are generated by `prisma db pull`.
// Flyway remains the only owner of the database schema.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Introspection snapshot. `prisma db pull` refreshes these models from Flyway's schema.
model AppUser {
  id                         BigInt        @id
  is_deleted                 Boolean       @default(false)
  username                   String        @db.Text
  firstname                  String        @db.Text
  lastname                   String        @db.Text
  password                   String        @db.Text
  email                      String        @db.Text
  nonlocked                  Boolean
  enabled                    Boolean
  last_time_password_updated DateTime      @default(dbgenerated("'1970-01-01 00:00:00'")) @db.DateTime(0)
  password_never_expires     Boolean       @default(false)
  cannot_change_password     Boolean       @default(false)
  AppUserRole                AppUserRole[]
  UserPhone                  UserPhone[]
}

model Role {
  id          BigInt        @id
  name        String        @db.Text
  description String        @db.Text
  is_disabled Boolean       @default(false)
  AppUserRole AppUserRole[]
}

model AppUserRole {
  appuser_id BigInt
  role_id    BigInt
  AppUser    AppUser @relation(fields: [appuser_id], references: [id], onUpdate: Cascade, map: "AppUserRole_appuser_id_fkey")
  Role       Role    @relation(fields: [role_id], references: [id], onUpdate: Cascade, map: "AppUserRole_role_id_fkey")

  @@id([appuser_id, role_id])
  @@index([role_id], map: "AppUserRole_role_id_fkey")
}

model UserPhone {
  id               Int     @id @default(autoincrement())
  user_id          BigInt
  phone_country_id Int
  phone            String  @db.VarChar(20)
  order_index      Int
  AppUser          AppUser @relation(fields: [user_id], references: [id], onUpdate: Cascade, map: "UserPhone_user_id_fkey")

  @@index([user_id], map: "UserPhone_user_id_fkey")
}
